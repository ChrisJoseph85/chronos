{"author": "Chronos", "build": {"appId": "ai.chronos.electron", "artifactName": "${productName}-${version}-${os}-${arch}.${ext}", "directories": {"output": "release"}, "files": ["dist/**/*", "main/**/*", "preload/**/*", "package.json"], "linux": {"category": "Utility", "target": ["AppImage"]}, "mac": {"identity": null, "target": ["dmg"]}, "productName": "Chronos", "win": {"target": ["nsis"]}}, "description": "Chronos direct Electron app (disk-loadable renderer, no web server)", "devDependencies": {"electron": "^44.5.1", "electron-builder": "^26.15.3", "vite": "^5.4.8"}, "main": "main/main.js", "name": "chronos-electron", "private": true, "scripts": {"build:renderer": "vite build && node scripts/inline-dist.js", "dist": "npm run build:renderer && electron-builder --linux AppImage", "dist:dir": "npm run build:renderer && electron-builder --linux dir", "pack": "npm run build:renderer && electron-builder --linux dir --publish never", "smoke": "electron . --smoke", "start": "electron .", "test": "node --test tests/"}, "type": "module", "version": "1.0.0"}